# FAH-Ablage – wird von manage.sh beim ersten Mal als .env angelegt und danach nie überschrieben.
ABLAGE_PORT=8093
PUID=1000
PGID=10
EINGANG_DIR=/home/benutzer/Dokumente/Eingang
ARCHIV_DIR=/home/benutzer/Dokumente/Ablage
# Import: Ordner darunter sind in der Oberfläche wählbar (nur lesend). IMPORT_DIR = Voreinstellung der Wahl.
QUELLEN_DIR=/home/benutzer
IMPORT_DIR=/home/benutzer/Dokumente/Privat
# Quelle für das Sprachmodell (wird einmalig nach ./modelle kopiert, kein Download)
MODELL_QUELLE=/volume3/docker/allinone-wl/knowsora/models/Qwen_Qwen3-4B-Instruct-2507-Q4_K_M.gguf
